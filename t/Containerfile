# Test image: nginx built from source with this module, and the tests in
# t/*.t, with nginx-tests' Test::Nginx and perl to run them (prove). Build
# context: the repository root (see the Makefile).

ARG ALPINE_VERSION=3.24.4
ARG NGINX_VERSION=1.30.6
ARG NGINX_TESTS_COMMIT=6bfff998d61070a745a5d26d7917654db57f660e

FROM docker.io/library/alpine:${ALPINE_VERSION} AS builder
ARG NGINX_VERSION
ARG NGINX_TESTS_COMMIT

RUN apk add --no-cache \
      gcc git linux-headers make musl-dev openssl-dev pcre2-dev zlib-dev

WORKDIR /build
RUN git clone --depth 1 --branch "release-${NGINX_VERSION}" \
      https://github.com/nginx/nginx.git \
 && git init -q nginx-tests \
 && git -C nginx-tests fetch -q --depth 1 \
      https://github.com/nginx/nginx-tests.git "${NGINX_TESTS_COMMIT}" \
 && git -C nginx-tests checkout -q FETCH_HEAD

COPY config /build/module/
COPY src/ /build/module/src/

WORKDIR /build/nginx
RUN ./auto/configure \
      --with-compat --with-http_ssl_module \
      --add-dynamic-module=../module \
 && make -j"$(nproc)"

# The tests run as a user of their own: nginx then runs its workers as
# that user too, and they can read the tests' files.
FROM docker.io/library/alpine:${ALPINE_VERSION}
RUN apk add --no-cache libcrypto3 libssl3 openssl pcre2 perl perl-utils zlib \
 && adduser -S -D -H -h /nonexistent -s /sbin/nologin test
COPY --from=builder /build/nginx/objs/nginx /usr/sbin/nginx
COPY --from=builder /build/nginx/objs/ngx_http_health_check_module.so \
     /usr/lib/nginx/modules/
COPY --from=builder /build/nginx-tests/lib/ /nginx-tests/lib/
COPY t/lib/ /tests/t/lib/
COPY t/*.t /tests/t/
ENV TEST_NGINX_BINARY=/usr/sbin/nginx \
    TEST_NGINX_GLOBALS="load_module /usr/lib/nginx/modules/ngx_http_health_check_module.so;"
USER test
WORKDIR /tests
ENTRYPOINT ["prove", "-I", "/nginx-tests/lib"]
CMD ["-j8", "t"]
